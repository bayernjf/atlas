# =====================================================================
# Atlas 环境变量模板
# 用法：cp .env.example .env 后填写真实值；.env 已被 .gitignore 忽略。
# 含 <占位符> 的是敏感值，绝不要把真实值提交进 git。
# 依赖清单与选型见 docs/10-技术选型决策记录.md；变量在代码落码时
# 同步增删，本文件保持与代码实际读取一致。
# =====================================================================

# ---------- 核心 ----------
# 环境档位（唯一入口 security/bootstrap.read_env_profile）：dev | test | prod，缺省 dev。
# 注意：只接受这三个值——写 development/production 之类的全称会让进程启动即抛
# （docs/63 §0A N5；健康探针里的 env 字段也取此值）。
ATLAS_ENV=dev
# prod 档位的首任管理员引导口令（docs/66 打包 L）：ATLAS_ENV=prod 时**必填**，
# 且须过口令策略（8-128 位、不在弱口令黑名单）。prod 不再播种仓库内明文种子口令，
# 缺这个值就拒绝启动（fail-closed）。dev/test 忽略本项。
ATLAS_ADMIN_BOOTSTRAP_PASSWORD=<prod 部署方自行生成的强口令>
# Demo API 端口（FastAPI，默认 8000）
PORT=8000
# 日志级别：debug | info | warning | error（默认 info）
LOG_LEVEL=info

# ---------- 数据库（PostgreSQL + pgvector） ----------
DATABASE_URL=postgresql+psycopg://atlas:<password>@localhost:5432/atlas
# 连接池大小（默认 10）
# DB_POOL_SIZE=10
# 存储后端档位（唯一入口 security/bootstrap.read_storage_backend）：memory | pg，缺省 memory。
# 只接受这两个值——写成 postgres 之类的别名会让进程启动即抛（docs/77 R4）。prod 必须 pg，
# 否则全部状态落在内存、重启即失。出厂 docker-compose 已设 pg。
# ATLAS_STORAGE_BACKEND=pg
# 空卷首启的连通性有界重试（docs/79 打包 S）：PG initdb 之后有一段 recovery 窗口会拒绝
# 一切连接，而 compose 的 pg_isready 探针在这段窗口里会判过 healthy。迁移 CLI 与应用启动
# 各自在下列预算内重试**连通性类**错误（认证失败/库不存在/SQL 语法等立即失败）。
# 预算缺省 120s（覆盖实测约 90s 的窗口）、间隔缺省 2s；非数字或负值回退缺省。
# ATLAS_DB_READY_TIMEOUT_SECONDS=120
# ATLAS_DB_READY_INTERVAL_SECONDS=2

# ---------- 模型网关（LiteLLM，T1 决策） ----------
# litellm 按模型前缀读取对应供应商密钥；**直连** OpenAI 兼容端点的变量名是
# OPENAI_API_KEY + OPENAI_BASE_URL（源码 litellm/llms/openai/common_utils.py:352-357）。
# 注意：LITELLM_API_KEY / LITELLM_BASE_URL 只被 litellm 的 proxy/MCP 代码读取，
# 本项目的 litellm.completion 直连调用路径**不读**这两个名字，配了不生效。
OPENAI_API_KEY=<your-provider-api-key>
# 供应商的 OpenAI 兼容端点（自建网关须带 /v1；不设则用 api.openai.com）
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# 模型名；自建 OpenAI 兼容网关用 "openai/<model>" 前缀指定路由。
# 未设置时退款决策/NL 生成走确定性规则兜底，Demo 可离线运行（见 src/atlas/llm/）。
# LITELLM_MODEL=openai/gpt-4o-mini

# ---------- Web 操作适配器（Playwright） ----------
# 无头模式（CI/服务器 1，本地调试可 0）
PLAYWRIGHT_HEADLESS=1
# 三层定位超时（毫秒，默认 5000）
# PLAYWRIGHT_TIMEOUT_MS=5000

# ---------- API 适配器（通用 HTTP，04 §4.6） ----------
# http/request 相对 URL 的默认 base URL；不设置时只允许绝对 URL
# ATLAS_HTTPAPI_BASE_URL=http://localhost:8000
# 公共请求头（JSON 对象，键级合并，节点 params 同名键优先）
# ATLAS_HTTPAPI_HEADERS={"X-Demo-Token":"demo-token"}
# 注入 Authorization: Bearer <token>（显式同名头优先于此）
# ATLAS_HTTPAPI_TOKEN=

# ---------- 数据适配器（通用 SQL，04 §4.7） ----------
# database/query|execute 的出站连接，仅适配器使用；与上方平台 DATABASE_URL
# 物理隔离，切勿填平台库（图操作可能写入）。允许 postgresql+psycopg / sqlite。
# 留空时后端使用内置 SQLite 内存 demo（seed 两笔演示订单，reset 重建）。
# ATLAS_DATABASE_URL=postgresql+psycopg://adapter:<password>@localhost:5432/target_db

# ---------- 出向安全准入（docs/32：SSRF / 重试熔断 / 凭证信封） ----------
# HTTP 出向白名单（逗号分隔，精确 host / *.后缀 / CIDR）。
# 留空＝仅 denylist（环回/私网/云元数据 169.254.169.254 等恒拦，公网放行）；
# 配置后仅命中项可出网（私网/元数据在白名单判定前恒拦，白名单不能放行）。
# ATLAS_HTTP_EGRESS_ALLOWLIST=api.example.com,*.cdn.example.com
# 出向重试：仅传输异常与 429/502/503/504、且幂等方法（GET/HEAD/PUT/DELETE，
# 或显式声明幂等的 POST）自动指数退避+全抖动重试。
# ATLAS_HTTP_MAX_ATTEMPTS=3
# ATLAS_HTTP_RETRY_BASE_DELAY=0.5
# 按 host 进程内熔断：连续失败达阈值开闸快速失败，冷却后半开放一个试探。
# ATLAS_HTTP_CIRCUIT_FAIL_THRESHOLD=5
# ATLAS_HTTP_CIRCUIT_COOLDOWN=30
# 凭证信封主密钥（AES-256-GCM，base64url 32 字节）。生成：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 未配置时退回明文 provider（仅 dev/demo，启动 WARNING）；配置后必须可用，
# 否则启动 fail-closed。主密钥绝不入库/入图 JSON/入日志。
# ATLAS_MASTER_KEY=
# ATLAS_MASTER_KEY_ID=k1
# 运行时秘密表（JSON {name: 明文或 enc$ 信封}）；HTTP url/headers 中以
# secret://<name> 引用，发送前在进程内解析，明文不进 last_request/observe/录制/日志。
# ATLAS_SECRETS={"shop_token":"dev-only-plaintext"}   # 生产值请放 enc$v1$... 信封

# ---------- 邮件真实投递（SMTP，docs/34 P0-2；D24 email 子集） ----------
# message/send 在 channel=email 时真实发信；HOST 留空＝回退进程内记录（demo）。
# ATLAS_SMTP_HOST=smtp.example.com
# ATLAS_SMTP_PORT=587
# ATLAS_SMTP_USERNAME=apikey
# ATLAS_SMTP_PASSWORD=
# ATLAS_SMTP_FROM=noreply@example.com
# ATLAS_SMTP_USE_TLS=true

# 审批挂起通知邮件里的应用入口（前端地址，docs/35 T2）。
# ATLAS_PUBLIC_URL=http://localhost:5174

# ---------- Shopify 侧 webhook 注册（docs/41；仅开发/测试） ----------
# 注册到 Shopify 的回调地址由 ATLAS_PUBLIC_URL 拼装，店铺侧要求 HTTPS。
# 仅供本地冒烟：把 Admin API base 指向同进程 mock，并绕过出向守卫；真实部署禁止设置。
# ATLAS_SHOPIFY_ADMIN_BASE_URL=http://127.0.0.1:8000/api/demo/mock/shopify-admin

# ---------- OAuth2 连接管理（generic，docs/35 T4） ----------
# 连接默认回调地址（须与平台后台登记一致）；留空用 http://localhost:8000/connections/callback。
# 凭据信封加密复用 ATLAS_MASTER_KEY（未配置时仅明文 dev，生产必须配置 32 字节主密钥）；
# OAuth state 的 CSRF 签名同样读 ATLAS_MASTER_KEY，缺失时用固定 dev 密钥并 WARNING。
# ATLAS_OAUTH_REDIRECT_URI=https://atlas.example.com/connections/callback

# ---------- 可观测栈（docker compose --profile observability，docs/35 T5） ----------
# Grafana 管理员密码（用户名 admin）。默认 atlasadmin 仅供本地演示，生产必须覆盖。
# GRAFANA_ADMIN_PASSWORD=atlasadmin

# ---------- 审计日志 ring 容量（docs/35 T6，仅内存档每租户；PG 档落 audit_events 表） ----------
# 每租户内存审计 ring 最大条数（最旧溢出丢弃），默认 2000，范围 1-100000。
# ATLAS_AUDIT_RING=2000

# ---------- 密钥管理（Vault，代码阶段接入） ----------
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=<your-vault-token>

# ---------- 可观测性（OpenTelemetry，代码阶段接入） ----------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=atlas

# ---------- 部署身份（CI 注入，health 探针 branch/commit 字段） ----------
# ATLAS_GIT_BRANCH=
# ATLAS_GIT_COMMIT=

# ---------- 定时触发调度器（docs/68 打包 N，2026-09-26） ----------
# 缺省即开启，两行都可以不写。cron 一律按 UTC 求值；重启/停摆期间错过的槽位不补跑；只跑已发布版本。
# ATLAS_SCHEDULE_ENABLED=1        # 置 0/false/no/off 只停"起调度线程"，登记与 /api/schedules 端点照旧
# ATLAS_SCHEDULE_TICK_SECONDS=30  # 评估间隔，clamp 到 1-300；非整数值回落 30 并 warning

# ---------- demo 模拟面开关（docs/75 打包 P，2026-09-27；docs/77 R2/R3/R5 复用） ----------
# prod 档下 demo 演示面默认全关（fail-closed），需要对外演示时显式开这一项。它一次管四处：
#   1) 商家后台/HTTP mock 路由（/api/demo/**、/demo/shop）→ 404；
#   2) 运行期演示适配器 shop/database（内置 DemoShopService / SQLite demo 库）不注册（图里选不到）；
#   3) FastAPI 文档面 /docs、/redoc、/openapi.json → 404；
#   4) 放行 ATLAS_SHOPIFY_ADMIN_BASE_URL 这条出向校验测试缝（prod 默认拒启）。
# 非 prod（dev/test）不需要设这一项，演示形态本来就开着。
# ATLAS_ENABLE_DEMO_MOCK=1

# ---------- A2A 执行 Agent 面（docs/90，ADR T32：Zeus 联邦 W2 接入） ----------
# Agent Card 的任务端点公开基址；留空则卡片 url 为相对路径（同 loom Q238 口径）。
# ATLAS_PUBLIC_BASE_URL=https://atlas.example.com
# 任务端点 POST /api/a2a/tasks 的 Bearer 令牌；与平台会话/渠道凭证分离。
# prod 档未配置即 fail-closed（401）；dev/test 未配置仅本地无鉴权联调并打 WARNING。
# ATLAS_A2A_TASK_TOKEN=
