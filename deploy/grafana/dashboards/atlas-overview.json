{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Atlas 开箱看板（docs/35 §5，D11 Grafana 子集）。指标严格对齐 observability/metrics_export.py 的 /metrics 输出；均为进程内窗口快照 gauge，不使用 rate()。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["atlas"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Atlas Overview",
  "uid": "atlas-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "进程存活",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "atlas_up", "datasource": { "type": "prometheus", "uid": "atlas-prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "活跃租户数",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "atlas_tenants_active", "datasource": { "type": "prometheus", "uid": "atlas-prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "存储后端",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "regex", "options": { "pattern": ".*memory.*", "result": { "text": "memory", "color": "yellow" } } },
            { "type": "regex", "options": { "pattern": ".*pg.*", "result": { "text": "postgres", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "textMode": "name" },
      "targets": [
        {
          "refId": "A",
          "expr": "atlas_storage_backend_info",
          "legendFormat": "{{backend}}",
          "datasource": { "type": "prometheus", "uid": "atlas-prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "运行成功率（窗口）",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(atlas_runs_success_rate)",
          "datasource": { "type": "prometheus", "uid": "atlas-prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "运行计数（按健康状态）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 }, "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*unhealthy.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (atlas_runs_total)",
          "legendFormat": "{{status}}",
          "datasource": { "type": "prometheus", "uid": "atlas-prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "运行耗时分位数（ms）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 }, "unit": "ms" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (quantile) (atlas_run_duration_ms)",
          "legendFormat": "p{{quantile}}",
          "datasource": { "type": "prometheus", "uid": "atlas-prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "工具调用计数（按工具与结果）",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "atlas-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 }, "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, status) (atlas_tool_calls_total)",
          "legendFormat": "{{tool}} / {{status}}",
          "datasource": { "type": "prometheus", "uid": "atlas-prometheus" }
        }
      ]
    }
  ]
}
